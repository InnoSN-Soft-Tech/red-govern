  "externalDocs": {
    "description": "Red-Govern remote metadata API contract",
    "url": "https://innosn-soft-tech.github.io/red-govern/agents/remote-metadata-api/"
  },
  "info": {
    "description": "Contract-only, read-only public metadata API for Red-Govern. This schema is versioned but the server is not deployed in Step 47.2B.",
    "title": "Red-Govern Remote Metadata API",
    "version": "0.1.0a3"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/commands": {
      "get": {
        "description": "Return the canonical command allowlist as public metadata. This endpoint never executes a command.",
        "operationId": "listRedGovernCommands",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandListResponse"
                }
              }
            },
            "description": "Version-matched canonical command allowlist."
          }
        },
        "security": [],
        "summary": "List canonical Red-Govern commands",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/v1/meta": {
      "get": {
        "description": "Return package version, platform, capability counts, public links, and safety boundaries. This action does not connect to Amazon Redshift.",
        "operationId": "getRedGovernMetadata",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            },
            "description": "Versioned public metadata."
          }
        },
        "security": [],
        "summary": "Get Red-Govern metadata",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/v1/problems": {
      "get": {
        "description": "List canonical problem summaries. Optionally filter by support status. The endpoint returns guidance metadata and does not execute commands.",
        "operationId": "listRedGovernProblems",
        "parameters": [
          {
            "description": "Optional support-status filter.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "enum": [
                "supported",
                "conditional",
                "unsupported"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemListResponse"
                }
              }
            },
            "description": "Version-matched problem summaries."
          }
        },
        "security": [],
        "summary": "List Red-Govern problem contracts",
        "tags": [
          "Metadata"
        ]
      }
    },
    "/v1/problems/{problem_id}": {
      "get": {
        "description": "Return one canonical problem contract by versioned problem id.",
        "operationId": "getRedGovernProblem",
        "parameters": [
          {
            "description": "Canonical kebab-case problem id.",
            "in": "path",
            "name": "problem_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "One canonical problem contract."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Problem id not found."
          }
        },
        "security": [],
        "summary": "Get one Red-Govern problem contract",
        "tags": [
          "Metadata"
        ]
      }
    }
  },
  "security": [],
  "servers": [
    {
      "description": "Planned endpoint; not deployed",
      "url": "https://api.snsoft.tech/red-govern"
    }
  ],
  "tags": [
    {
      "description": "Versioned public Red-Govern metadata only.",
      "name": "Metadata"
    }
  ],
  "x-red-govern-deployment-status": "contract-only-not-deployed"
}
