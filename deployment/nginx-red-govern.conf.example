# Example edge configuration for the Red-Govern public metadata API.
# Adapt certificate paths and upstream topology to the selected host.
# Do not commit private keys or provider credentials.

limit_req_zone $binary_remote_addr zone=red_govern_metadata:10m rate=5r/s;

server {
    listen 80;
    server_name api.snsoft.tech;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.snsoft.tech;

    ssl_certificate     /etc/ssl/example/fullchain.pem;
    ssl_certificate_key /etc/ssl/example/privkey.pem;

    client_max_body_size 16k;

    location = /red-govern {
        return 308 /red-govern/;
    }

    location /red-govern/ {
        limit_except GET {
            deny all;
        }

        limit_req zone=red_govern_metadata burst=20 nodelay;

        rewrite ^/red-govern(/.*)$ $1 break;
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 15s;

        proxy_hide_header Server;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "public, max-age=60" always;
    }
}
